DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambia-esto-en-tu-env-local
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://loan:loan@localhost:5432/loan_service

# Usadas por el servicio db de docker-compose
POSTGRES_DB=loan_service
POSTGRES_USER=loan
POSTGRES_PASSWORD=loan
# Puerto del host donde se publica PostgreSQL. Cámbialo (y DATABASE_URL) si 5432 está ocupado.
POSTGRES_PORT=5432

# Correo simulado: no hay SMTP. "console" imprime el correo en la consola (en
# Docker, en `docker compose logs web`); "file" lo guarda en EMAIL_FILE_PATH.
EMAIL_BACKEND=console
EMAIL_FILE_PATH=tmp/emails
DEFAULT_FROM_EMAIL=no-responder@localhost

# Auditoría: número de proxies de confianza delante de Django. Con 0 (por
# defecto) la IP es la de la conexión y se ignora X-Forwarded-For, porque el
# cliente puede falsificarla. Pon 1 solo si hay un proxy propio (por ejemplo,
# nginx) que siempre reescribe esa cabecera.
AUDIT_TRUSTED_PROXIES=0
